{
  "name": "dsh-context-usage-for-agent",
  "version": "0.5.1",
  "type": "module",
  "description": "显示 DSH 会话的上下文占用：context_usage 工具 + 每轮读数 + 设置页",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "dixie_2003 (https://github.com/dixieWithHeart)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "usage",
    "tokens"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixieWithHeart/dsh-context-usage-for-agent.git"
  },
  "homepage": "https://github.com/dixieWithHeart/dsh-context-usage-for-agent",
  "bugs": {
    "url": "https://github.com/dixieWithHeart/dsh-context-usage-for-agent/issues"
  }
}
